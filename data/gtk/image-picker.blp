using Gtk 4.0;
using Adw 1;

template $ImagePicker: Adw.Dialog {
  content-width: 780;
  content-height: 640;
  title: _("Escolher imagem");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      [end]
      ToggleButton animated_button {
        label: _("Animadas");
        tooltip-text: _("Mostrar capas animadas");
        visible: false;
      }
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: true;

      Adw.Clamp {
        maximum-size: 450;

        SearchEntry search_entry {
          placeholder-text: _("Buscar jogo…");
          hexpand: true;
        }
      }
    }

    [top]
    Box source_bar {
      halign: center;
      margin-top: 6;
      margin-bottom: 6;
      margin-start: 12;
      margin-end: 12;

      Box {
        halign: center;

        styles [
          "linked",
        ]

        ToggleButton source_sgdb {
          label: "SteamGridDB";
          active: true;
        }

        ToggleButton source_igdb {
          label: "IGDB";
        }

        ToggleButton source_tgdb {
          label: "TheGamesDB";
        }

        ToggleButton source_wallhaven {
          label: "Wallhaven";
        }

        ToggleButton source_file {
          label: _("Arquivo");
        }
      }
    }

    [top]
    Box filter_box {
      orientation: vertical;
    }

    Stack stack {
      transition-type: crossfade;
      vexpand: true;

      StackPage {
        name: "loading";

        child: Adw.Spinner spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage status_page {
          icon-name: "image-x-generic-symbolic";
          title: _("Nada por aqui");
          description: _("Tente buscar por outro nome.");
        };
      }

      StackPage {
        name: "file";

        child: Box {
          orientation: vertical;
          halign: center;
          valign: center;
          spacing: 12;

          Button file_button {
            label: _("Escolher arquivo…");
            halign: center;

            styles [
              "suggested-action",
              "pill",
            ]
          }
        };
      }

      StackPage {
        name: "results";

        child: Box {
          orientation: vertical;

          Label matched_label {
            halign: center;
            margin-top: 8;
            visible: false;

            styles [
              "dim-label",
              "caption",
            ]
          }

          ScrolledWindow {
            hscrollbar-policy: never;
            vexpand: true;

            FlowBox flowbox {
              homogeneous: true;
              halign: center;
              valign: start;
              column-spacing: 12;
              row-spacing: 12;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
              selection-mode: none;
              min-children-per-line: 2;
              max-children-per-line: 4;

              styles [
                "no-hover",
              ]
            }
          }
        };
      }
    }
  }
}
