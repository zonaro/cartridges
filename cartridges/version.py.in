# Versão de compilação no formato YY.DDD.HHMM (ano 2 dígitos, dia do ano,
# hora+minuto 24h). Gerado por build-aux/write-version.py via custom_target
# (build_always_stale) a cada `meson compile`, portanto reflete a data de
# compilação e não a do `meson setup`.
BUILD_VERSION = "@VCS_TAG@"
